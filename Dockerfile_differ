# https://hub.docker.com/_/debian
FROM docker.io/debian:sid-slim AS build
MAINTAINER Jelmer Vernooij <jelmer@jelmer.uk>

ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update --yes \
 && apt-get install --yes --no-install-recommends \
        auto-apt-proxy \
        iproute2 \
 && apt-get satisfy --yes --no-install-recommends \
        ca-certificates \
        cargo \
        g++ \
        gcc \
        libclang-dev \
        libpython3-dev \
        libssl-dev \
        nettle-dev \
        pkg-config \
        protobuf-compiler \
        python3-minimal \
 && apt-get clean

COPY . /code

RUN cargo build --verbose --release --manifest-path /code/differ/Cargo.toml


# https://hub.docker.com/_/debian
FROM docker.io/debian:sid-slim
MAINTAINER Jelmer Vernooij <jelmer@jelmer.uk>

ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update --yes \
 && apt-get install --yes --no-install-recommends \
        auto-apt-proxy \
        iproute2 \
 && apt-get upgrade --yes \
 && apt-get install --yes --no-install-recommends \
        ca-certificates \
        devscripts \
        diffoscope-minimal \
        libssl3 \
        python3-breezy \
        python3-debian \
        python3-gpg \
 && apt-get satisfy --yes --no-install-recommends \
        "libpython$(python3 -c 'import sys; print("%d.%d" % sys.version_info[:2])')" \
 && apt-get clean \
 && rm -rf /var/lib/apt/lists/*

COPY --from=build /code/target/release/janitor-differ /usr/local/bin/janitor-differ

EXPOSE 9920

ENTRYPOINT ["janitor-differ", "--port=9920", "--listen-address=::"]
