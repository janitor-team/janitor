# https://hub.docker.com/_/debian
FROM docker.io/debian:sid-slim AS build
MAINTAINER Jelmer Vernooij <jelmer@jelmer.uk>

ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update --yes \
 && apt-get install --yes --no-install-recommends \
        auto-apt-proxy \
        iproute2 \
 && apt-get satisfy --yes --no-install-recommends \
        ca-certificates \
        cargo \
        libapt-pkg-dev \
        libclang-dev \
        libpython3-dev \
        libssl-dev \
        nettle-dev \
        pkg-config \
        protobuf-compiler \
        python3-minimal \
 && apt-get clean

COPY . /code

RUN cargo build --verbose --release --manifest-path /code/runner/Cargo.toml



# https://hub.docker.com/_/debian
FROM docker.io/debian:sid-slim
MAINTAINER Jelmer Vernooij <jelmer@jelmer.uk>

ARG DEBIAN_FRONTEND=noninteractive

# janitor-runner embeds CPython via breezyshim to drive breezy/
# silver-platter for VCS operations, and shells out to dpkg-dev for
# Debian-specific build/changes parsing.
RUN apt-get update --yes \
 && apt-get install --yes --no-install-recommends \
        auto-apt-proxy \
        iproute2 \
 && apt-get upgrade --yes \
 && apt-get install --yes --no-install-recommends \
        brz-debian \
        ca-certificates \
        dpkg-dev \
        git \
        libapt-pkg-dev \
        libssl3 \
        openssh-client \
        python3-breezy \
        python3-debian \
        python3-launchpadlib \
 && apt-get satisfy --yes --no-install-recommends \
        "libpython$(python3 -c 'import sys; print("%d.%d" % sys.version_info[:2])')" \
 && apt-get clean \
 && rm -rf /var/lib/apt/lists/*

COPY --from=build /code/target/release/janitor-runner /usr/local/bin/janitor-runner

EXPOSE 9911

EXPOSE 9919

ENTRYPOINT ["janitor-runner", "--port=9911",  "--public-port=9919", "--listen-address=::"]
