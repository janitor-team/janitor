# Vagrant's janitor_domain is a bare IP (see group_vars/vagrant.yml) - a
# bare hostname/IP address here triggers Caddy's automatic-HTTPS/ACME
# machinery, which can never issue a real cert for a private VM IP - it
# triggers a 308 redirect to https, followed by a TLS handshake failure.
# A port-only address matches any Host on plain HTTP, no ACME attempt,
# and works by IP without DNS. Real deployments get a real domain in
# janitor_domain, so Caddy gets a real cert and serves HTTPS - matching
# the https://{{ janitor_domain }}/ URLs the other roles already build.
{{ ':80' if 'vagrant' in group_names else janitor_domain }} {
	handle /git/* {
		reverse_proxy 127.0.0.1:9924
	}
	handle /bzr/* {
		reverse_proxy 127.0.0.1:9930
	}
	handle {
		reverse_proxy 127.0.0.1:8090
	}
}
{% if 'vagrant' in group_names %}

# handle_login/handle_oauth_callback set secure=True on session/state
# cookies (matching real deployments), which browsers silently drop over
# plain HTTP - testing a real OAuth login against this VM needs a real
# HTTPS listener too. tls internal (Caddy's own local-CA automatic HTTPS)
# needs to write to its trust store, which the caddy service account
# isn't sudo'd for - fails the handshake outright rather than just
# skipping trust-store registration. Point at a plain self-signed cert
# instead (generated by the openssl task below) - the browser will warn
# on an unrecognized cert, same as any self-signed one, but the TLS
# session itself completes.
:443 {
	tls /etc/caddy/vagrant-selfsigned.crt /etc/caddy/vagrant-selfsigned.key
	handle /git/* {
		reverse_proxy 127.0.0.1:9924
	}
	handle /bzr/* {
		reverse_proxy 127.0.0.1:9930
	}
	handle {
		reverse_proxy 127.0.0.1:8090
	}
}
{% endif %}
