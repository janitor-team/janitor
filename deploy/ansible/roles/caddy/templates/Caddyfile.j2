# Managed by ansible (roles/caddy).
{# Headers on every public site, with Strict-Transport-Security only on HTTPS. #}
{# Every public site also has an access log: JSON lines on stderr, in caddy's journal. #}
{% macro security_headers(https, frame_options='DENY', csp="frame-ancestors 'none'; object-src 'none'; base-uri 'self'") %}
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options {{ frame_options }}
		# Only when the service sends no policy of its own.
		?Content-Security-Policy "{{ csp }}"
		Referrer-Policy strict-origin-when-cross-origin
{% if https %}
		Strict-Transport-Security "max-age={{ caddy_hsts_max_age }}"
{% endif %}
		-Server
		# Also replace the headers the services send.
		defer
	}
{%- endmacro %}
{% macro janitor_routes() %}
	# Workers reach the runner's public API under /runner/, without the prefix.
	handle_path /runner/* {
		reverse_proxy {{ janitor_loopback }}:9919
	}
	handle /git/* {
		reverse_proxy {{ janitor_loopback }}:9924
	}
	handle /bzr/* {
		reverse_proxy {{ janitor_loopback }}:9930
	}
{% if enable_ognibuild_dep | bool %}
	handle_path /ognibuild-dep/* {
		@not_dep_client not remote_ip {{ ognibuild_dep_clients | join(' ') }}
		respond @not_dep_client 403
		reverse_proxy {{ janitor_loopback }}:9934
	}
{% endif %}
	# The apt repository metadata. The site serves the pool files itself.
	handle /dists/* {
		reverse_proxy {{ janitor_loopback }}:9915
	}
	handle {
		reverse_proxy {{ janitor_loopback }}:8090
	}
{% endmacro %}
{% if janitor_scheme == 'http' %}
{# A bare port serves plain HTTP for any host name, with no ACME attempt. #}
:80 {
{{ security_headers(false) }}
	log
{{ janitor_routes() }}}
{% else %}
{{ ':443' if caddy_self_signed | default(false) | bool else janitor_url_host }} {
{% if caddy_self_signed | default(false) | bool %}
	tls /etc/caddy/janitor.crt /etc/caddy/janitor.key
{% endif %}
{{ security_headers(true) }}
	log
{{ janitor_routes() }}}
{% if enable_gitea | bool %}

{{ gitea_domain }} {
{% if caddy_self_signed | default(false) | bool %}
	tls /etc/caddy/janitor.crt /etc/caddy/janitor.key
{% endif %}
	# Gitea's PDF viewer frames the file from Gitea itself.
{{ security_headers(true, 'SAMEORIGIN', "frame-ancestors 'self'") }}
	log
	reverse_proxy {{ janitor_loopback }}:{{ gitea_http_port }}
}
{% endif %}

# Plain HTTP serves only the apt repository (janitor_apt_archive_url) and
# sends everything else, worker logins included, to HTTPS.
{{ ':80' if caddy_self_signed | default(false) | bool else 'http://' + janitor_url_host }} {
{{ security_headers(false) }}
	log
	handle /dists/* {
		reverse_proxy {{ janitor_loopback }}:9915
	}
	# Pool files: <suite>/pkg/<codebase>/<run id>/<file>. The site serves
	# the run's logs on the same path, so only package files match.
	@apt_pool path_regexp ^/[^/]+/pkg/[^/]+/[^/]+/[^/]+\.(u?deb|ddeb|dsc|diff\.gz|tar\.(gz|xz|bz2|lzma|zst)(\.asc)?)$
	handle @apt_pool {
		reverse_proxy {{ janitor_loopback }}:8090
	}
{% if enable_gitea | bool and caddy_self_signed | default(false) | bool %}
	@gitea host {{ gitea_domain }}
	handle @gitea {
		redir https://{{ gitea_domain }}{uri} permanent
	}
{% endif %}
	# The configured name, never the client's Host header.
	handle {
		redir https://{{ janitor_url_host }}{uri} permanent
	}
}
{% endif %}
{% if enable_tracing | bool %}

# janitor.conf's zipkin_address, on loopback: the site posts Zipkin JSON,
# the Rust services OTLP, and Jaeger takes each on a port of its own.
:{{ tracing_port }} {
	bind {{ janitor_loopback_addresses | join(" ") }}
	handle /api/v2/spans {
		reverse_proxy {{ janitor_loopback }}:{{ jaeger_zipkin_port }}
	}
	handle {
		reverse_proxy {{ janitor_loopback }}:{{ jaeger_otlp_port }}
	}
}
{% endif %}
