# Managed by ansible (roles/apt_cacher_ng).
[Unit]
Description=nftables table janitor_apt_cacher_ng: the apt cache's port only from loopback and its clients
Wants=network-pre.target
Before=network-pre.target shutdown.target
# nftables.service loads the whole ruleset: follow its restart and reload.
After=nftables.service
PartOf=nftables.service
ReloadPropagatedFrom=nftables.service
Conflicts=shutdown.target
DefaultDependencies=no

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -f /etc/janitor-apt-cacher-ng-firewall.nft
ExecReload=/usr/sbin/nft -f /etc/janitor-apt-cacher-ng-firewall.nft
ExecStop=-/usr/sbin/nft delete table inet janitor_apt_cacher_ng

[Install]
WantedBy=sysinit.target
