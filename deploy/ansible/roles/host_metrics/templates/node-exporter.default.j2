# Managed by Ansible (roles/host_metrics). Its textfiles: the unit
# states and, on the control host, the run and pipeline counts and (with
# the apt cache) apt-cacher-ng's transfer counts and cache size.
ARGS="--web.listen-address={{ host_metrics_address }}:{{ node_exporter_port }} --collector.textfile.directory={{ host_metrics_textfile_dir }}{% if enable_apt_cacher_ng | bool and 'control' in group_names %} --collector.textfile.directory=/var/lib/janitor-apt-cacher-ng-metrics{% endif %}"
