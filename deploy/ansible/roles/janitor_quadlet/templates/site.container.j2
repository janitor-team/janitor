# Managed by ansible (roles/janitor_quadlet).
[Unit]
Description=janitor site
After=janitor-runner.service janitor-publish.service janitor-archive.service janitor-differ.service

[Container]
Image=ghcr.io/jelmer/janitor/site:latest
ContainerName=janitor-site
Network=host
# The whole command line is given here, as for the other services.
Entrypoint=janitor-site
Exec=--host 127.0.0.1 --port 8080 --public-port 8090 --config /mnt/janitor/janitor.conf --archiver-url http://127.0.0.1:9914/ --differ-url http://127.0.0.1:9920/ --publisher-url http://127.0.0.1:9912/ --runner-url http://127.0.0.1:9911/ --external-url {{ janitor_external_url }}
Volume={{ janitor_home }}/janitor.conf:/mnt/janitor/janitor.conf:ro
{% if janitor_s3_access_key_id | length > 0 %}
EnvironmentFile={{ janitor_home }}/s3.env
{% endif %}
Volume={{ janitor_home }}/data/logs:/mnt/janitor/data/logs:ro
Volume={{ janitor_home }}/data/artifacts:/mnt/janitor/data/artifacts:ro
{% if caddy_self_signed | default(false) | bool %}
# The host's CA bundle, which holds the self-signed certificate (Gitea's too).
Volume=/etc/ssl/certs/ca-certificates.crt:/etc/ssl/certs/ca-certificates.crt:ro
{% endif %}
{% include 'common.j2' %}
