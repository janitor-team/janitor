[Unit]
Description=janitor runner (tier 2, needs git_store's public port)
After=network-online.target janitor-git_store.service janitor-differ.service janitor-archive.service
Wants=network-online.target

[Container]
Image=ghcr.io/jelmer/janitor/runner:latest
ContainerName=janitor-runner
Network=host
# --listen-address overrides the image's own baked-in
# --listen-address=0.0.0.0 (Dockerfile_runner's ENTRYPOINT) - see
# worker.container.j2's own comment for why this needs overriding rather
# than an Entrypoint replacement, and why the override itself is safe
# (argparse keeps the last occurrence of a repeated flag). Binds both the
# admin API (port) and the public API (public-port, what a worker actually
# talks to for assignments - see worker.container.j2's --base-url) to this
# one address; single-host default (runner_bind_address, group_vars/
# all.yml) is loopback, since a co-located worker already reaches it via
# localhost (Network=host, same box). A worker on a different host needs
# this bound to an address it can actually reach - see group_vars/
# control.yml. --public-vcs-location is what a worker fetches VCS content
# from during a build (git_store's own public port); same reasoning,
# see group_vars/all.yml's git_store_public_address.
Exec=--listen-address {{ runner_bind_address }} --port=9911 --public-port=9919 --config /mnt/janitor/janitor.conf --public-vcs-location=http://{{ git_store_public_address }}:9924/
Volume={{ janitor_home }}:/mnt/janitor:rw
Volume=/home/{{ ansible_user }}/.config/breezy:/root/.config/breezy:ro

# Already pulled this exact image explicitly in roles/janitor_source
# - never re-check the registry on every service start (quadlet's default
# for a :latest tag). That re-check was slow enough on this network to
# blow TimeoutStartSec below, failing the start outright even though the
# image was already present locally.
Pull=never

[Service]
Restart=on-failure
RestartSec=5
TimeoutStartSec=60

[Install]
WantedBy=default.target
