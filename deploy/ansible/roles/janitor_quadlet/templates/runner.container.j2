# Managed by ansible (roles/janitor_quadlet).
[Unit]
Description=janitor runner
After=janitor-git_store.service janitor-bzr_store.service

[Container]
Image=ghcr.io/jelmer/janitor/runner:latest
ContainerName=janitor-runner
Network=host
# The whole command line is given here.
Entrypoint=janitor-runner
Exec=--listen-address 127.0.0.1 --port 9911 --public-port 9919 --config /mnt/janitor/janitor.conf --public-vcs-location {{ janitor_external_url }} --public-apt-archive-location {{ janitor_apt_archive_url }}{% if enable_ognibuild_dep | bool %} --public-dep-server-url {{ janitor_external_url }}ognibuild-dep/{% endif +%}
Volume={{ janitor_home }}/janitor.conf:/mnt/janitor/janitor.conf:ro
Volume={{ janitor_home }}/data/logs:/mnt/janitor/data/logs:rw
Volume={{ janitor_home }}/data/artifacts:/mnt/janitor/data/artifacts:rw
Volume={{ janitor_breezy_dir }}/runner:/root/.config/breezy:ro
{% if caddy_self_signed | default(false) | bool %}
# The host's CA bundle, which holds the self-signed certificate (Gitea's too).
Volume=/etc/ssl/certs/ca-certificates.crt:/etc/ssl/certs/ca-certificates.crt:ro
{% endif %}
{% include 'common.j2' %}
