[Unit]
Description=Remake the sbuild chroot tarball and the build session image
After=janitor-worker.service

[Service]
Type=oneshot
ExecStart=/usr/bin/podman exec janitor-worker sh -c "{{ janitor_quadlet_sbuild_chroot_build | replace('%', '%%') }}"
ExecStart=/usr/bin/podman exec janitor-worker ogni cache-env --force {{ janitor_distribution }}
Restart=on-failure
RestartSec=1h
