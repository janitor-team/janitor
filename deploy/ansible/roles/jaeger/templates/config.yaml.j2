# Managed by ansible (roles/jaeger). Every port is on loopback.
service:
  extensions: [jaeger_storage, jaeger_query, healthcheckv2]
  pipelines:
    traces:
      receivers: [otlp, zipkin]
      processors: [batch]
      exporters: [jaeger_storage_exporter]
  telemetry:
    metrics:
      level: none
    logs:
      level: info

extensions:
  jaeger_storage:
    backends:
      memstore:
        memory:
          max_traces: {{ jaeger_max_traces }}
  jaeger_query:
    # Jaeger sends no spans of its own.
    enable_tracing: false
    storage:
      traces: memstore
    http:
      endpoint: "{{ janitor_loopback }}:{{ jaeger_ui_port | int }}"
    grpc:
      endpoint: "{{ janitor_loopback }}:{{ jaeger_ui_port | int - 1 }}"
  healthcheckv2:
    use_v2: true
    http:
      endpoint: "{{ janitor_loopback }}:{{ jaeger_health_port }}"

receivers:
  otlp:
    protocols:
      http:
        endpoint: "{{ janitor_loopback }}:{{ jaeger_otlp_port }}"
  zipkin:
    endpoint: "{{ janitor_loopback }}:{{ jaeger_zipkin_port }}"

processors:
  batch: {}

exporters:
  jaeger_storage_exporter:
    trace_storage: memstore
