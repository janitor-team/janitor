# Managed by ansible (roles/janitor_config). The runner's and site's S3 key.
{% if janitor_s3_endpoint_url | length > 0 %}
AWS_ENDPOINT_URL={{ janitor_s3_endpoint_url }}
{% endif %}
AWS_ACCESS_KEY_ID={{ janitor_s3_access_key_id }}
AWS_SECRET_ACCESS_KEY={{ janitor_s3_secret_access_key }}
AWS_REGION={{ janitor_s3_region }}
