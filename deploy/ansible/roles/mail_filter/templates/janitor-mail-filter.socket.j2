# Managed by ansible (roles/mail_filter).
[Unit]
Description=janitor mail filter socket ({{ mail_filter_command }} writes one mail to it)

[Socket]
ListenStream=%t/janitor-mail-filter.sock
SocketMode=0600
Accept=yes
# Set the MTA to run fewer filter deliveries at once than this.
MaxConnections={{ mail_filter_max_instances }}

[Install]
WantedBy=sockets.target
