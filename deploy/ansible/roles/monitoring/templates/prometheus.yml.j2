# Managed by Ansible (roles/monitoring).
global:
  scrape_interval: 30s
rule_files:
  - /etc/prometheus/rules/*.rules
{# The blackbox exporter's targets, {job: [{url, labels}]}. #}
{% set worker_targets = [] %}
{% if 'worker' in group_names %}
{% for port in janitor_worker_instances.values() %}
{% set _ = worker_targets.append({'url': 'http://%s:%s/health' % (janitor_worker_url_host, port),
                                  'labels': {'host': inventory_hostname, 'worker': worker_name}}) %}
{% endfor %}
{% endif %}
{% for host, address in monitoring_worker_addresses.items() %}
{% for n in range(hostvars[host].janitor_worker_concurrency | default(janitor_worker_concurrency) | int) %}
{% set _ = worker_targets.append({'url': 'http://%s:%d/health' % ('[%s]' % address if ':' in address else address, 9821 + n),
                                  'labels': {'host': host, 'worker': hostvars[host].worker_name | default(worker_name)}}) %}
{% endfor %}
{% endfor %}
{% set health_targets = [] %}
{% for job in prometheus_jobs if job != 'auto_upload' %}
{% set _ = health_targets.append({'url': janitor_health_urls[job], 'labels': {'service': job}}) %}
{% endfor %}
{% set probes = {'worker': worker_targets, 'health': health_targets} %}
{% if enable_ognibuild_dep | bool %}
{% set _ = probes.update({'ognibuild_dep': [{'url': janitor_health_urls.ognibuild_dep, 'labels': {}}]}) %}
{% endif %}
scrape_configs:
{% for job in prometheus_jobs %}
  - job_name: {{ job }}
    static_configs:
      - targets: ["{{ janitor_health_urls[job] | urlsplit('netloc') }}"]
{% endfor %}
  - job_name: prometheus
    static_configs:
      - targets: ["{{ janitor_loopback }}:{{ prometheus_port }}"]
  - job_name: grafana
    static_configs:
      - targets: ["{{ janitor_loopback }}:{{ grafana_port }}"]
  # Caddy's admin API.
  - job_name: caddy
    static_configs:
      - targets: ["127.0.0.1:2019"]
{% if enable_gitea | bool %}
  - job_name: gitea
    authorization:
      credentials_file: /etc/prometheus/gitea_metrics_token
    static_configs:
      - targets: ["{{ janitor_loopback }}:{{ gitea_http_port }}"]
{% endif %}
{% if enable_garage | bool %}
  - job_name: garage
    static_configs:
      - targets: ["{{ janitor_loopback }}:{{ garage_admin_port }}"]
{% endif %}
{% if enable_tracing | bool %}
  - job_name: jaeger
    static_configs:
      - targets: ["{{ janitor_loopback }}:{{ jaeger_metrics_port }}"]
{% endif %}
{% if enable_node_exporter | bool %}
  - job_name: node
    static_configs:
      - targets: ["{{ janitor_loopback }}:{{ node_exporter_port }}"]
        labels: {host: "{{ inventory_hostname }}"}
{% for host, address in monitoring_worker_addresses.items() %}
      - targets: ["{{ '[%s]' % address if ':' in address else address }}:{{ node_exporter_port }}"]
        labels: {host: "{{ host }}"}
{% endfor %}
{% endif %}
{% for name in monitoring_exporters %}
  - job_name: {{ name }}
{% if name == 'pushgateway' %}
    # Keeps the job label the worker pushes with (janitor.worker).
    honor_labels: true
{% endif %}
    static_configs:
      - targets: ["{{ janitor_loopback }}:{{ monitoring_exporter_settings[name].port }}"]
{% endfor %}
{% if enable_blackbox_exporter | bool %}
{% for job, targets in probes.items() if targets %}
  # The blackbox exporter checks the page of each {{ job }} target.
  - job_name: {{ job }}
    metrics_path: /probe
    params:
      module: [http_health]
    static_configs:
{% for target in targets %}
      - targets: {{ [target.url] | to_json }}
        labels: {{ target.labels | to_json }}
{% endfor %}
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: "{{ janitor_loopback }}:{{ blackbox_exporter_port }}"
{% endfor %}
{% endif %}
