; Managed by ansible (roles/gitea). Paths are inside the container.
APP_NAME = Gitea
RUN_MODE = prod
WORK_PATH = /var/lib/gitea

[server]
APP_DATA_PATH = /var/lib/gitea/data
PROTOCOL = http
HTTP_ADDR = {{ janitor_loopback_addresses | first }}
HTTP_PORT = {{ gitea_http_port }}
; Caddy serves it over HTTPS.
DOMAIN = {{ gitea_domain }}
ROOT_URL = {{ gitea_root_url | default('https://' + gitea_domain + '/') }}
START_SSH_SERVER = true
SSH_DOMAIN = {{ gitea_domain }}
; Only publish pushes over SSH. Its container maps gitea_domain to loopback.
SSH_LISTEN_HOST = {{ janitor_loopback_addresses | first }}
SSH_PORT = {{ gitea_ssh_port }}
SSH_LISTEN_PORT = {{ gitea_ssh_port }}
SSH_SERVER_HOST_KEYS = ssh/gitea.ed25519
LFS_START_SERVER = false
OFFLINE_MODE = true

[database]
DB_TYPE = sqlite3
PATH = /var/lib/gitea/data/gitea.db

[security]
INSTALL_LOCK = true
SECRET_KEY = {{ gitea_secrets.secret_key }}
INTERNAL_TOKEN = {{ gitea_secrets.internal_token }}

[oauth2]
JWT_SECRET = {{ gitea_secrets.jwt_secret }}

[service]
DISABLE_REGISTRATION = true
DEFAULT_KEEP_EMAIL_PRIVATE = true
{% if enable_mta | bool %}
ENABLE_NOTIFY_MAIL = true

[mailer]
; The MTA on this host (roles/mta), which delivers only locally.
ENABLED = true
PROTOCOL = smtp
SMTP_ADDR = {{ janitor_loopback_addresses | first }}
SMTP_PORT = 25
FROM = Gitea <gitea@{{ gitea_domain }}>
{% endif %}

[repository]
ROOT = /var/lib/gitea/git/repositories

[migrations]
; Lets the playbook copy gitea_test_repos in from public forges.
ALLOWED_DOMAINS = {{ gitea_test_repos | map(attribute='clone_url') | map('urlsplit', 'hostname') | unique | join(',') }}

[webhook]
; janitor's webhook receiver is on the same host.
ALLOWED_HOST_LIST = {{ janitor_domain }}

[cron.update_checker]
; Off, so Gitea does not ask dl.gitea.com for a new version each week.
ENABLED = false

{% if enable_monitoring | bool %}
[metrics]
; Caddy serves Gitea publicly, so /metrics needs the token (roles/monitoring).
ENABLED = true
TOKEN = {{ gitea_secrets.metrics_token }}

{% endif %}
[log]
MODE = console
LEVEL = info
