# -*- mode: ruby -*-
# vi: set ft=ruby :
#
# Local VMs running the same playbook as a multi-host setup:
# "control" (the janitor services, PostgreSQL, Redis, Caddy) and two
# workers that take work from the same runner.
# Each VM runs the playbook for its own groups with ansible_local. See
# README.md, "Several hosts".
#
#   VAGRANT_VAGRANTFILE=Vagrantfile.multi-host vagrant up
#   VAGRANT_VAGRANTFILE=Vagrantfile.multi-host vagrant rsync   # then provision
#   VAGRANT_VAGRANTFILE=Vagrantfile.multi-host vagrant ssh control
#   VAGRANT_VAGRANTFILE=Vagrantfile.multi-host vagrant destroy

require "fileutils"
require "json"
require "securerandom"

USE_PREBUILT = ENV.fetch("JANITOR_USE_PREBUILT", "false") == "true"
# A local janitor checkout to deploy (rsynced into each VM), or empty to
# clone JANITOR_REPO.
JANITOR_SOURCE = ENV.fetch("JANITOR_SOURCE", "")
JANITOR_REPO = ENV.fetch("JANITOR_REPO", "https://github.com/janitor-team/janitor.git")
JANITOR_BRANCH = ENV.fetch("JANITOR_BRANCH", "main")
NETWORK = ENV.fetch("JANITOR_NETWORK", "192.168.60")
STORAGE_POOL = ENV.fetch("JANITOR_STORAGE_POOL", "default")

# name => [groups, last address octet, vCPUs, memory in MB, disk in GB]
MACHINES = {
  "control" => [["control"], 11, 8, 24576, 200],
  "worker1" => [["worker"], 21, 6, 12288, 150],
  "worker2" => [["worker"], 22, 6, 12288, 150],
}
CONTROL_IP = "#{NETWORK}.11"
WORKERS = MACHINES.select { |_, (machine_groups, *)| machine_groups.include?("worker") }.keys

# A password per worker, made once and kept outside the synced folder:
# control gets every worker's, each worker only its own.
PASSWORDS_FILE = File.join(__dir__, ".vagrant", "worker-passwords.json")
passwords = File.exist?(PASSWORDS_FILE) ? JSON.parse(File.read(PASSWORDS_FILE)) : {}
unless (WORKERS - passwords.keys).empty?
  WORKERS.each { |w| passwords[w] ||= SecureRandom.alphanumeric(32) }
  FileUtils.mkdir_p(File.dirname(PASSWORDS_FILE))
  File.write(PASSWORDS_FILE, JSON.generate(passwords), perm: 0o600)
end
WORKER_ENTRIES = WORKERS.to_h { |w| [w, { name: w, password: passwords[w] }] }

Vagrant.configure("2") do |config|
  # trixie, the release the playbook targets.
  config.vm.box = "debian/trixie64"
  config.vm.synced_folder ".", "/vagrant", type: "rsync", rsync__exclude: [".vagrant/"]
  unless JANITOR_SOURCE.empty?
    config.vm.synced_folder JANITOR_SOURCE, "/srv/janitor-src", type: "rsync",
      rsync__exclude: ["target/", ".tox/", "*.pyc", "__pycache__/"]
  end

  # The box grows its partition to the disk size at boot, but not the
  # filesystem.
  config.vm.provision "grow-root", type: "shell",
    inline: 'resize2fs "$(findmnt -no SOURCE /)"'
  # trixie's Python is externally managed, so take ansible-core from apt.
  config.vm.provision "ansible-core", type: "shell",
    inline: "apt-get update -qq && apt-get install -y -qq ansible-core"

  groups = { "janitor" => MACHINES.keys, "vagrant" => MACHINES.keys }
  MACHINES.each do |name, (machine_groups, _, _, _, _)|
    machine_groups.each { |g| (groups[g] ||= []) << name }
  end

  MACHINES.each do |name, (machine_groups, octet, cpus, memory, disk)|
    config.vm.define name do |machine|
      ip = "#{NETWORK}.#{octet}"
      machine.vm.hostname = "janitor-#{name}"
      machine.vm.network "private_network", ip: ip,
        libvirt__network_name: "janitor-e2e", libvirt__forward_mode: "none"
      machine.vm.provider "libvirt" do |lv|
        lv.cpus = cpus
        lv.memory = memory
        lv.storage_pool_name = STORAGE_POOL
        lv.machine_virtual_size = disk
      end
      machine.vm.provision "ansible_local" do |ansible|
        ansible.playbook = "ansible/site.yml"
        ansible.galaxy_role_file = "ansible/requirements.yml"
        # The default galaxy command passes --roles-path, which skips collections.
        ansible.galaxy_command = "ansible-galaxy collection install --requirements-file=%{role_file}"
        ansible.compatibility_mode = "2.0"
        ansible.groups = groups
        ansible.limit = name
        ansible.extra_vars = {
          ansible_user: "vagrant",
          use_prebuilt_images: USE_PREBUILT,
          janitor_repo: JANITOR_SOURCE.empty? ? JANITOR_REPO : "/srv/janitor-src",
          janitor_branch: JANITOR_BRANCH,
          janitor_domain: CONTROL_IP,
          janitor_worker_address: ip,
          # Only the VMs' own network may use the dependency server.
          ognibuild_dep_clients: ["#{NETWORK}.0/24"],
          janitor_workers: machine_groups.include?("control") ? WORKER_ENTRIES.values : [WORKER_ENTRIES[name]].compact,
        }
      end
    end
  end
end
