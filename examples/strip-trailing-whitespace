#!/bin/sh
# Example codemod for a generic campaign: strip trailing whitespace from text files.
set -e
find . \( -name .git -o -name .bzr -o -path ./debian/patches -o -name '*.patch' -o -name '*.diff' \) \
    -prune -o -type f -exec perl -pi -e 's/[ \t]+$// if -T $ARGV' {} +
echo "Strip trailing whitespace."
