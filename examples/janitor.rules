groups:
- name: janitor.rules
  rules:
  - alert: JanitorRunnerDown
    expr: up{job="janitor.runner"} == 0
    for: 1h
    labels:
      severity: critical
      project: janitor
    annotations:
      description: Job {{ $labels.job }} instance {{ $labels.instance }} is down.
      summary: Janitor runner is down
  - alert: JanitorPublisherDown
    expr: up{job="janitor.publisher"} == 0
    for: 1h
    labels:
      severity: critical
      project: janitor
    annotations:
      description: Job {{ $labels.job }} instance {{ $labels.instance }} is down.
      summary: Janitor publisher is down
  - alert: JanitorSiteDown
    expr: up{job="janitor.site"} == 0
    for: 1h
    labels:
      severity: critical
      project: janitor
    annotations:
      description: Job {{ $labels.job }} instance {{ $labels.instance }} is down.
      summary: Janitor site is down
  - alert: JanitorDifferDown
    expr: up{job="janitor.differ"} == 0
    for: 1h
    labels:
      severity: critical
      project: janitor
    annotations:
      description: Job {{ $labels.job }} instance {{ $labels.instance }} is down.
      summary: Janitor differ is down
  - alert: JanitorArchiverDown
    expr: up{job="janitor.archiver"} == 0
    for: 1h
    labels:
      severity: critical
      project: janitor
    annotations:
      description: Job {{ $labels.job }} instance {{ $labels.instance }} is down.
      summary: Janitor archiver is down
  - alert: JanitorGitStoreDown
    expr: up{job="janitor.git_store"} == 0
    for: 1h
    labels:
      severity: critical
      project: janitor
    annotations:
      description: Job {{ $labels.job }} instance {{ $labels.instance }} is down.
      summary: Janitor git store is down

  - alert: JanitorBzrStoreDown
    expr: up{job="janitor.bzr_store"} == 0
    for: 1h
    labels:
      severity: critical
      project: janitor
    annotations:
      description: Job {{ $labels.job }} instance {{ $labels.instance }} is down.
      summary: Janitor bzr store is down

  - alert: JanitorHighRequestFailureRate
    expr: increase(request_exceptions_total{job="janitor.site"}[30m]) > 5
    for: 0m
    labels:
      severity: critical
      project: janitor
    annotations:
      description: "{{ $labels.route }} requests to {{ $labels.instance }} are failing."
      summary: "{{ $labels.route }} requests are failing"

  - alert: JanitorRequestFailures
    expr: increase(request_exceptions_total{job="janitor.site"}[30m]) > 0
    for: 0m
    labels:
      severity: warning
      project: janitor
    annotations:
      description: "{{ $labels.route }} requests to {{ $labels.instance }} are failing."
      summary: "{{ $labels.route }} requests are failing"

  - alert: JobRestarting
    expr: avg without(instance)(changes(process_start_time_seconds[1h])) > 3
    for: 10m
    labels:
      severity: critical
      project: janitor
    annotations:
      description: Job {{ $labels.job }} restarted more than 3 times in the last hour.
      summary: Janitor job {{ $labels.job }} is restarting

  - alert: SiteDown
    expr: probe_http_status_code{job="blackbox_https"} != 200
    for: 5m
    labels:
      severity: critical
      project: janitor
    annotations:
      description: "{{ $labels.instance }} answered with HTTP status {{ $value }} (0 means no answer)."
      summary: Janitor site is not returning HTTP 200

  - alert: WorkerCrashing
    expr: sum without(instance, campaign)(increase(result_total{result_code="worker-failure"}[10m])) > 5
    for: 10m
    labels:
      severity: critical
      project: janitor
    annotations:
      description: More than 5 runs ended in worker-failure in the last 10 minutes.
      summary: Workers are crashing

  - alert: UploadsFailing
    expr: increase(upload_failed{job="janitor.auto_upload"}[1h]) > 0
    labels:
      severity: warning
      project: janitor
    annotations:
      description: "Some uploads are failing on {{ $labels.instance }}."
      summary: Some uploads are failing

  - alert: UploadSignFailing
    expr: increase(debsign_failed{job="janitor.auto_upload"}[1h]) > 0
    labels:
      severity: warning
      project: janitor
    annotations:
      description: "Some debsign commands are failing on {{ $labels.instance }}."
      summary: Some debsign commands are failing
