# https://hub.docker.com/_/debian
FROM docker.io/debian:sid-slim AS build
MAINTAINER Jelmer Vernooij <jelmer@jelmer.uk>

ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update --yes \
 && apt-get install --yes --no-install-recommends \
        auto-apt-proxy \
        iproute2 \
 && apt-get satisfy --yes --no-install-recommends \
        ca-certificates \
        cargo \
        libclang-dev \
        libpython3-dev \
        libssl-dev \
        nettle-dev \
        pkg-config \
        protobuf-compiler \
        python3-minimal \
 && apt-get clean

COPY . /code

RUN cargo build --verbose --release --manifest-path /code/git-store/Cargo.toml



# https://hub.docker.com/_/debian
FROM docker.io/debian:sid-slim
MAINTAINER Jelmer Vernooij <jelmer@jelmer.uk>

ARG DEBIAN_FRONTEND=noninteractive

# klaus is the HTML browser the public app serves via PyO3; it's a
# GitHub-only Python package, pip-installed over Debian-packaged
# flask/dulwich/python3-git to avoid pulling the whole setuptools
# toolchain into the image.
RUN apt-get update --yes \
 && apt-get install --yes --no-install-recommends \
        auto-apt-proxy \
        iproute2 \
 && apt-get upgrade --yes \
 && apt-get satisfy --yes --no-install-recommends \
        ca-certificates \
        git \
        libssl3 \
        python3-breezy \
        python3-klaus \
 && apt-get satisfy --yes --no-install-recommends \
        "libpython$(python3 -c 'import sys; print("%d.%d" % sys.version_info[:2])')" \
 && apt-get clean \
 && rm -rf /var/lib/apt/lists/*

COPY --from=build /code/target/release/janitor-git-store /usr/local/bin/janitor-git-store

VOLUME /git

EXPOSE 9923

EXPOSE 9924

ENTRYPOINT ["janitor-git-store", "--port=9923", "--public-port=9924", "--listen-address=::", "--vcs-path=/git"]
