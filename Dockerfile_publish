# https://hub.docker.com/_/debian
FROM docker.io/debian:sid-slim AS build
MAINTAINER Jelmer Vernooij <jelmer@jelmer.uk>

ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update --yes \
 && apt-get install --yes --no-install-recommends \
        auto-apt-proxy \
        iproute2 \
 && apt-get satisfy --yes --no-install-recommends \
        ca-certificates \
        cargo \
        libclang-dev \
        libpython3-dev \
        libssl-dev \
        nettle-dev \
        pkg-config \
        protobuf-compiler \
        python3-minimal \
 && apt-get clean

COPY . /code

RUN cargo build --verbose --release --manifest-path /code/publish/Cargo.toml



# https://hub.docker.com/_/debian
FROM docker.io/debian:sid-slim
MAINTAINER Jelmer Vernooij <jelmer@jelmer.uk>

ARG DEBIAN_FRONTEND=noninteractive

# janitor-publish embeds CPython via breezyshim and drives breezy
# (github/gitlab/launchpad forges) and silver-platter for publishing.
# gnupg is needed so gpgme's agent socket can be created at startup
# (GPGContext::new() calls gpg.Context() which spawns gpg-agent).
RUN apt-get update --yes \
 && apt-get install --yes --no-install-recommends \
        auto-apt-proxy \
        iproute2 \
 && apt-get upgrade --yes \
 && apt-get satisfy --yes --no-install-recommends \
        brz-debian \
        ca-certificates \
        git \
        gnupg \
        libpython3-dev \
        libssl3 \
        openssh-client \
        python3-breezy \
        python3-debian \
        python3-gpg \
        python3-launchpadlib \
 && apt-get satisfy --yes --no-install-recommends \
        "libpython$(python3 -c 'import sys; print("%d.%d" % sys.version_info[:2])')" \
 && apt-get clean \
 && rm -rf /var/lib/apt/lists/*

COPY --from=build /code/target/release/janitor-publish /usr/local/bin/janitor-publish
COPY --from=build /code/target/release/janitor-publish-one /usr/local/bin/janitor-publish-one

EXPOSE 9912

ENTRYPOINT ["janitor-publish", "--port=9912", "--listen-address=::"]
