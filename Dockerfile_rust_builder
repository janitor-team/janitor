# Shared build stage of the Rust service images (RUST_IMAGES in the Makefile).
# https://hub.docker.com/_/debian
FROM docker.io/debian:testing-slim AS build
MAINTAINER Jelmer Vernooij <jelmer@jelmer.uk>

ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update --yes \
 && apt-get install --yes --no-install-recommends \
        auto-apt-proxy \
        iproute2 \
 && apt-get upgrade --yes \
 && apt-get satisfy --yes --no-install-recommends \
       ## Standard packages: ./CONTRIBUTING.md
        ca-certificates \
        cargo \
        g++ \
        gcc \
        libclang-dev \
        libpython3-dev \
        libssl-dev \
        nettle-dev \
        pkg-config \
        protobuf-compiler \
       ## Extra packages
        python3-minimal \
 && apt-get clean

COPY . /code

# One target/ for the seven builds; it is removed in the same layer.
RUN cd /code \
 && cargo build --release --manifest-path archive/Cargo.toml --bin janitor-archive \
 && cargo build --release --manifest-path auto-upload/Cargo.toml --bin janitor-auto-upload \
 && cargo build --release --manifest-path bzr-store/Cargo.toml --bin janitor-bzr-store \
 && cargo build --release --manifest-path differ/Cargo.toml --bin janitor-differ \
 && cargo build --release --manifest-path git-store/Cargo.toml --bin janitor-git-store \
 && cargo build --release --manifest-path publish/Cargo.toml --bin janitor-publish --bin janitor-publish-one \
 && cargo build --release --manifest-path runner/Cargo.toml --features gcp --bin janitor-runner \
 && mkdir /out \
 && cd target/release \
 && cp janitor-archive janitor-auto-upload janitor-bzr-store janitor-differ \
        janitor-git-store janitor-publish janitor-publish-one janitor-runner /out/ \
 && rm -rf /code/target "${CARGO_HOME:-$HOME/.cargo}"

# The service Dockerfiles copy from the same path as before.
FROM scratch
COPY --from=build /out/ /code/target/release/
